{
  "description": "Stop-time review gate. Inactive until `dsh-companion setup --enable-review-gate` runs for the workspace.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/stop-review-gate-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\scripts\\stop-review-gate-hook.mjs\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
